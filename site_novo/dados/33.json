UAL' AND uf = 'TODAS';\n\nSELECT partido, eleitos, eleitos_por_legenda, pct_por_legenda, eleitos_votos_proprios, fora_dos_mais_votados, votos_nominais, votos_legenda,\n       pct_votos_legenda, posicao\nFROM mv_q5_partido\nWHERE ano = 2018 AND cargo = 'DEPUTADO ESTADUAL' AND uf = 'TODAS'\nORDER BY posicao;\n\nSELECT e.nome_urna, e.partido, e.sg_uf, m.nome AS municipio, e.votos, e.quociente, e.pct_do_quociente, e.posicao_votos, e.vagas\nFROM mv_q5_eleito e\nLEFT JOIN municipio m ON m.cod_ibge = e.cod_ibge\nWHERE e.ano = 2018 AND e.cargo = 'DEPUTADO ESTADUAL' AND ('TODAS' = 'TODAS' OR e.sg_uf = 'TODAS')\nORDER BY e.pct_do_quociente, e.votos, e.nome_urna\nLIMIT 10;\n\nSELECT b.nome_urna, b.partido, b.sg_uf, m.nome AS municipio, b.votos, b.quociente, b.pct_do_quociente, b.posicao_votos, b.vagas\nFROM mv_q5_barrado b\nLEFT JOIN municipio m ON m.cod_ibge = b.cod_ibge\nWHERE b.ano = 2018 AND b.cargo = 'DEPUTADO ESTADUAL' AND ('TODAS' = 'TODAS' OR b.sg_uf = 'TODAS')\nORDER BY b.votos DESC, b.nome_urna\nLIMIT 10;","dados":{"resumo":{"circunscricoes":6,"vagas":222,"eleitos":222,"eleitos_por_legenda":220,"pct_por_legenda":99.1,"faixa_100_mais":2,"faixa_50_99":89,"faixa_20_49":127,"faixa_menos_20":4,"fora_dos_mais_votados":22,"pct_fora_dos_mais_votados":9.9,"mediana_pct_quociente":47.2,"votos_validos":17556977,"votos_legenda":1347081,"pct_votos_legenda":7.67},"partidos":[{"partido":"MDB","eleitos":28,"eleitos_por_legenda":28,"pct_por_legenda":100,"eleitos_votos_proprios":0,"fora_dos_mais_votados":0,"votos_nominais":1778869,"votos_legenda":180148,"pct_votos_legenda":9.2,"posicao":1},{"partido":"PSD","eleitos":21,"eleitos_por_legenda":21,"pct_por_legenda":100,"eleitos_votos_proprios":0,"fora_dos_mais_votados":0,"votos_nominais":1468237,"votos_legenda":80488,"pct_votos_legenda":5.2,"posicao":2},{"partido":"PSB","eleitos":18,"eleitos_por_legenda":17,"pct_por_legenda":94.4,"eleitos_votos_proprios":1,"fora_dos_mais_votados":0,"votos_nominais":1316122,"votos_legenda":62703,"pct_votos_