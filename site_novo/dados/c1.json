{"/api/q5?ano=2020&cargo=VEREADOR&uf=AL":{"sql":"SELECT circunscricoes, vagas, eleitos, eleitos_por_legenda, pct_por_legenda, faixa_100_mais, faixa_50_99, faixa_20_49, faixa_menos_20,\n       fora_dos_mais_votados, pct_fora_dos_mais_votados, mediana_pct_quociente, votos_validos, votos_legenda, pct_votos_legenda\nFROM mv_q5_resumo\nWHERE ano = 2020 AND cargo = 'VEREADOR' AND uf = 'AL';\n\nSELECT partido, eleitos, eleitos_por_legenda, pct_por_legenda, eleitos_votos_proprios, fora_dos_mais_votados, votos_nominais, votos_legenda,\n       pct_votos_legenda, posicao\nFROM mv_q5_partido\nWHERE ano = 2020 AND cargo = 'VEREADOR' AND uf = 'AL'\nORDER BY posicao;\n\nSELECT e.nome_urna, e.partido, e.sg_uf, m.nome AS municipio, e.votos, e.quociente, e.pct_do_quociente, e.posicao_votos, e.vagas\nFROM mv_q5_eleito e\nLEFT JOIN municipio m ON m.cod_ibge = e.cod_ibge\nWHERE e.ano = 2020 AND e.cargo = 'VEREADOR' AND ('AL' = 'TODAS' OR e.sg_uf = 'AL')\nORDER BY e.pct_do_quociente, e.votos, e.nome_urna\nLIMIT 10;\n\nSELECT b.nome_urna, b.partido, b.sg_uf, m.nome AS municipio, b.votos, b.quociente, b.pct_do_quociente, b.posicao_votos, b.vagas\nFROM mv_q5_barrado b\nLEFT JOIN municipio m ON m.cod_ibge = b.cod_ibge\nWHERE b.ano = 2020 AND b.cargo = 'VEREADOR' AND ('AL' = 'TODAS' OR b.sg_uf = 'AL')\nORDER BY b.votos DESC, b.nome_urna\nLIMIT 10;","dados":{"resumo":{"circunscricoes":102,"vagas":1086,"eleitos":1086,"eleitos_por_legenda":1060,"pct_por_legenda":97.6,"faixa_100_mais":26,"faixa_50_99":594,"faixa_20_49":459,"faixa_menos_20":7,"fora_dos_mais_votados":125,"pct_fora_dos_mais_votados":11.5,"mediana_pct_quociente":53.2,"votos_validos":1557040,"votos_legenda":87013,"pct_votos_legenda":5.59},"partidos":[{"partido":"MDB","eleitos":307,"eleitos_por_legenda":301,"pct_por_legenda":98,"eleitos_votos_proprios":6,"fora_dos_mais_votados":24,"votos_nominais":339624,"votos_legenda":23514,"pct_votos_legenda":6.48,"posicao":1},{"partido":"PP","eleitos":206,"eleitos_por_legenda":203,"pct_por_legenda"