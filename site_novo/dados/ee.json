{"/api/q5?ano=2018&cargo=DEPUTADO FEDERAL&uf=PB":{"sql":"SELECT circunscricoes, vagas, eleitos, eleitos_por_legenda, pct_por_legenda, faixa_100_mais, faixa_50_99, faixa_20_49, faixa_menos_20,\n       fora_dos_mais_votados, pct_fora_dos_mais_votados, mediana_pct_quociente, votos_validos, votos_legenda, pct_votos_legenda\nFROM mv_q5_resumo\nWHERE ano = 2018 AND cargo = 'DEPUTADO FEDERAL' AND uf = 'PB';\n\nSELECT partido, eleitos, eleitos_por_legenda, pct_por_legenda, eleitos_votos_proprios, fora_dos_mais_votados, votos_nominais, votos_legenda,\n       pct_votos_legenda, posicao\nFROM mv_q5_partido\nWHERE ano = 2018 AND cargo = 'DEPUTADO FEDERAL' AND uf = 'PB'\nORDER BY posicao;\n\nSELECT e.nome_urna, e.partido, e.sg_uf, m.nome AS municipio, e.votos, e.quociente, e.pct_do_quociente, e.posicao_votos, e.vagas\nFROM mv_q5_eleito e\nLEFT JOIN municipio m ON m.cod_ibge = e.cod_ibge\nWHERE e.ano = 2018 AND e.cargo = 'DEPUTADO FEDERAL' AND ('PB' = 'TODAS' OR e.sg_uf = 'PB')\nORDER BY e.pct_do_quociente, e.votos, e.nome_urna\nLIMIT 10;\n\nSELECT b.nome_urna, b.partido, b.sg_uf, m.nome AS municipio, b.votos, b.quociente, b.pct_do_quociente, b.posicao_votos, b.vagas\nFROM mv_q5_barrado b\nLEFT JOIN municipio m ON m.cod_ibge = b.cod_ibge\nWHERE b.ano = 2018 AND b.cargo = 'DEPUTADO FEDERAL' AND ('PB' = 'TODAS' OR b.sg_uf = 'PB')\nORDER BY b.votos DESC, b.nome_urna\nLIMIT 10;","dados":{"resumo":{"circunscricoes":1,"vagas":12,"eleitos":12,"eleitos_por_legenda":12,"pct_por_legenda":100,"faixa_100_mais":0,"faixa_50_99":7,"faixa_20_49":5,"faixa_menos_20":0,"fora_dos_mais_votados":0,"pct_fora_dos_mais_votados":0,"mediana_pct_quociente":53.6,"votos_validos":1989377,"votos_legenda":141920,"pct_votos_legenda":7.13},"partidos":[{"partido":"PSDB","eleitos":3,"eleitos_por_legenda":3,"pct_por_legenda":100,"eleitos_votos_proprios":0,"fora_dos_mais_votados":0,"votos_nominais":239696,"votos_legenda":10681,"pct_votos_legenda":4.27,"posicao":1},{"partido":"DEM","eleitos":1,"eleitos_por_legenda":1,"