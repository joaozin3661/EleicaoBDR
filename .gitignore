dados/entradas/
dados/saida_carga/
*.csv
!banco/referencia/*.csv
*.zip
*.7z
*.parquet
*.xlsx
*.xls
*.dta
*.rds
*.pkl

# cópias do banco (pg_dump) nunca vão para o git
dados/_dump/
*.dump

# frontend: as miniaturas das fotos (geradas por npm run fotos em api/; 30 mil arquivos)
frontend/fotos/
.playwright-cli/
