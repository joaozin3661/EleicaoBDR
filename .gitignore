# segredos (um .env só, na raiz)
.env
!.env.example

# python / node
__pycache__/
*.pyc
node_modules/
dist/
.venv/
venv/
*.log
npm-debug.log*

# editor e sistema: configurações locais de cada um (VS Code com Live Server, JetBrains) e lixo do Windows/macOS
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# dados/: o que a coleta baixa e a carga gera fica fora do git (reprodutível com python -m coleta e banco/carga/)
dados/tse/*
!dados/tse/leiames_unificados/
dados/ibge/
dados/ipea_atlas/
dados/ideologia_partidos/
dados/extrato_bancario_partido_2024/
