# Copie este arquivo para .env (nesta mesma pasta, a raiz do projeto) e coloque a senha do seu postgres.
# É o único .env do projeto: a API (api/), as exportações (api/exportacao/) e a carga (banco/carga/) leem daqui.
# O .env nunca vai para o GitHub.
PGHOST=localhost
PGPORT=5432
PGDATABASE=eleicoes
PGUSER=postgres
PGPASSWORD=COLOQUE_SUA_SENHA_AQUI
PORT=3001
