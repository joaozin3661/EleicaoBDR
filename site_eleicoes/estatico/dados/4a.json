{"/api/q5?ano=2018&cargo=DEPUTADO FEDERAL&uf=SE":{"sql":"SELECT circunscricoes, vagas, eleitos, eleitos_por_legenda, pct_por_legenda, faixa_100_mais, faixa_50_99, faixa_20_49, faixa_menos_20,\n       fora_dos_mais_votados, pct_fora_dos_mais_votados, mediana_pct_quociente, votos_validos, votos_legenda, pct_votos_legenda\nFROM mv_q5_resumo\nWHERE ano = 2018 AND cargo = 'DEPUTADO FEDERAL' AND uf = 'SE';\n\nSELECT partido, eleitos, eleitos_por_legenda, pct_por_legenda, eleitos_votos_proprios, fora_dos_mais_votados, votos_nominais, votos_legenda,\n       pct_votos_legenda, posicao\nFROM mv_q5_partido\nWHERE ano = 2018 AND cargo = 'DEPUTADO FEDERAL' AND uf = 'SE'\nORDER BY posicao;\n\nSELECT e.nome_urna, e.partido, e.sg_uf, m.nome AS municipio, e.votos, e.quociente, e.pct_do_quociente, e.posicao_votos, e.vagas\nFROM mv_q5_eleito e\nLEFT JOIN municipio m ON m.cod_ibge = e.cod_ibge\nWHERE e.ano = 2018 AND e.cargo = 'DEPUTADO FEDERAL' AND ('SE' = 'TODAS' OR e.sg_uf = 'SE')\nORDER BY e.pct_do_quociente, e.votos, e.nome_urna\nLIMIT 10;\n\nSELECT b.nome_urna, b.partido, b.sg_uf, m.nome AS municipio, b.votos, b.quociente, b.pct_do_quociente, b.posicao_votos, b.vagas\nFROM mv_q5_barrado b\nLEFT JOIN municipio m ON m.cod_ibge = b.cod_ibge\nWHERE b.ano = 2018 AND b.cargo = 'DEPUTADO FEDERAL' AND ('SE' = 'TODAS' OR b.sg_uf = 'SE')\nORDER BY b.votos DESC, b.nome_urna\nLIMIT 10;","dados":{"resumo":{"circunscricoes":1,"vagas":8,"eleitos":8,"eleitos_por_legenda":8,"pct_por_legenda":100,"faixa_100_mais":0,"faixa_50_99":5,"faixa_20_49":3,"faixa_menos_20":0,"fora_dos_mais_votados":1,"pct_fora_dos_mais_votados":12.5,"mediana_pct_quociente":52.1,"votos_validos":953969,"votos_legenda":67189,"pct_votos_legenda":7.04},"partidos":[{"partido":"PT","eleitos":2,"eleitos_por_legenda":2,"pct_por_legenda":100,"eleitos_votos_proprios":0,"fora_dos_mais_votados":0,"votos_nominais":122516,"votos_legenda":12512,"pct_votos_legenda":9.27,"posicao":1},{"partido":"MDB","eleitos":1,"eleitos_por_legenda":1,"pct_